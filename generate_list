
/* generate a linked list for testing purpose*/
#include <stdio.h>
#include <stdlib.h>

typedef struct node
{
    int data;
    struct node *link;
} slist;

int main()
{
    slist *head = NULL, *temp = NULL, *newnode;
    int n, i;

    printf("Enter number of nodes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++)
    {
        newnode = (slist *)malloc(sizeof(slist));

        printf("Enter data: ");
        scanf("%d", &newnode->data);

        newnode->link = NULL;

        if (head == NULL)
        {
            head = newnode;
            temp = newnode;
        }
        else
        {
            temp->link = newnode;
            temp = newnode;
        }
    }

    printf("Linked list: ");
    temp = head;

    while (temp != NULL)
    {
        printf("%d -> ", temp->data);
        temp = temp->link;
    }

    printf("NULL\n");

    return 0;
}
